---
import { Image } from 'astro:assets';
import categories from "../data/categories.json";
import products from "../data/products.json";

const base = import.meta.env.BASE_URL;

const categoriesWithImage = categories.map((cat) => ({
  ...cat,
  productCount: products.filter((p) => p.category === cat.slug).length,
}));
---

<section class="collection" id="koleksi">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">Koleksi Produk</p>
      <h2>Dipilih Untuk<br />Setiap Perayaan</h2>
    </div>
  </div>
  <div class="col-grid">
    {categoriesWithImage.map((cat) => (
      <a class="col-item reveal" href={`${base}/${cat.slug}`}>
        <Image src={cat.image} alt={cat.name} width={700} height={933} loading="lazy" />
        <div class="label">
          <span class="eb">{cat.productCount} Produk</span>
          <h3>{cat.name}</h3>
        </div>
      </a>
    ))}
  </div>

</section>
