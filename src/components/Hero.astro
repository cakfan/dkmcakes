---
import { Image } from 'astro:assets';
import config from "../data/config.json";
import Seal from "./Seal.astro";
const { hero, business } = config;
const base = import.meta.env.BASE_URL;
---

<section class="hero" id="top">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-copy reveal in">
        <p class="eyebrow on-dark">{hero.eyebrow}</p>
        <h1>{hero.headlinePlain}<br />{hero.headlinePlain2} <em>{hero.headlineEmphasis}</em></h1>
        <p>{hero.description}</p>
        <div class="hero-actions">
          <a href={`${base}#koleksi`} class="btn btn-gold">Lihat Koleksi</a>
          <a href={business.whatsappUrl} class="btn btn-outline">Konsultasi via WhatsApp</a>
        </div>
      </div>
      <div class="hero-media">
        <div class="frame">
          <Image src={hero.image} alt={hero.imageAlt} width={900} height={1125} loading="eager" fetchpriority="high" />
        </div>
        <Seal variant="hero" centerText={hero.sealCenter} subText={hero.sealSub} ringText={hero.sealRing} />
      </div>
    </div>
  </div>
</section>
