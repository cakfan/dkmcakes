---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ProductCard from "../components/ProductCard.astro";
import config from "../data/config.json";
import categories from "../data/categories.json";
import products from "../data/products.json";

export function getStaticPaths() {
  return categories.map((cat) => {
    const catProducts = products.filter((p) => p.category === cat.slug);
    return {
      params: { category: cat.slug },
      props: { category: cat, catProducts },
    };
  });
}

const { category, catProducts } = Astro.props;
const base = import.meta.env.BASE_URL;

const pageTitle = `${category.name} — ${config.site.name}`;
const pageDescription = category.description;

const waMessage = encodeURIComponent(`Halo DKM, saya ingin tanya-tanya soal ${category.name}`);
const waLink = `https://wa.me/${config.business.phoneIntl.replace("+", "")}?text=${waMessage}`;
---

<Layout title={pageTitle} description={pageDescription} ogImage={category.image} ogImageWidth={700} ogImageHeight={933}>
  <Header />
  <main id="main-content">
    <section class="cat-hero">
      <div class="container">
        <nav class="breadcrumb reveal in" aria-label="Breadcrumb"><a href={base}>Beranda</a><span>/</span><span>{category.name}</span></nav>
        <div class="section-head reveal">
          <p class="eyebrow">{category.tagline}</p>
          <h1>{category.name}</h1>
          <p class="cat-desc">{category.description}</p>
        </div>
      </div>
    </section>

    <section class="product-grid-section">
      <div class="container">
        <h2 class="sr-only">Daftar Produk {category.name}</h2>
        <div class="product-count reveal">
          <span>{catProducts.length} Produk</span>
          <a href={waLink} class="btn btn-gold" target="_blank" rel="noopener noreferrer">Pesan via WhatsApp</a>
        </div>
        <div class="product-grid">
          {catProducts.map((product) => (
            <ProductCard
              slug={product.slug}
              name={product.name}
              category={category.name}
              image={product.image}
              alt={product.alt}
              price={product.price}
              priceNote={product.priceNote}
              categorySlug={category.slug}
            />
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .cat-hero {
    padding-top: 150px;
    padding-bottom: 60px;
    background: var(--bg-light);
  }
  .cat-desc {
    color: var(--text-muted);
    font-size: 17px;
    max-width: 560px;
    margin-top: 16px;
  }
  .product-grid-section {
    padding: 40px 0 120px;
    background: var(--bg-light);
  }
  .product-count {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 32px;
    font-size: 14px;
    color: var(--text-muted);
  }
  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  @media (max-width: 980px) {
    .product-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .product-grid { grid-template-columns: 1fr; }
  }
</style>
