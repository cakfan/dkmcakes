---
import { Image } from 'astro:assets';
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import config from "../../data/config.json";
import categories from "../../data/categories.json";
import products from "../../data/products.json";

export function getStaticPaths() {
  const paths = [];
  for (const cat of categories) {
    const catProducts = products.filter((p) => p.category === cat.slug);
    for (const product of catProducts) {
      paths.push({
        params: { category: cat.slug, slug: product.slug },
        props: { product, category: cat },
      });
    }
  }
  return paths;
}

const { product, category } = Astro.props;
const base = import.meta.env.BASE_URL;

const pageTitle = `${product.name} — ${config.site.name}`;
const pageDescription = product.description;

const waMessage = encodeURIComponent(`Halo DKM, saya ingin tanya-tanya soal ${product.name}`);
const waLink = `https://wa.me/${config.business.phoneIntl.replace("+", "")}?text=${waMessage}`;

function priceToNumeric(price: string): string {
  return price.replace(/[^0-9]/g, "");
}

const productUrl = `${config.site.url}/${category.slug}/${product.slug}`;

const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: product.name,
  image: product.image,
  description: product.description,
  category: category.name,
  brand: { "@type": "Brand", name: config.site.name },
  url: productUrl,
  offers: product.price ? {
    "@type": "Offer",
    price: priceToNumeric(product.price),
    priceCurrency: "IDR",
    availability: "https://schema.org/InStock",
    url: productUrl,
    seller: { "@type": "Organization", name: config.site.name },
    itemCondition: "https://schema.org/NewCondition",
  } : undefined,
};

const relatedProducts = products
  .filter((p) => p.category === category.slug && p.slug !== product.slug)
  .slice(0, 3);
---

<Layout title={pageTitle} description={pageDescription} ogImage={product.image} ogImageWidth={700} ogImageHeight={933}>
  <Header />
  <main id="main-content">
    <section class="product-detail">
      <div class="container">
        <nav class="breadcrumb reveal in" aria-label="Breadcrumb"><a href={base}>Beranda</a><span>/</span><a href={`${base}/${category.slug}`}>{category.name}</a><span>/</span><span>{product.name}</span></nav>

        <div class="product-grid">
          <div class="product-media reveal in">
            <Image src={product.image} alt={product.alt} width={700} height={933} loading="eager" fetchpriority="high" />
          </div>
          <div class="product-copy reveal in">
            <p class="eyebrow">{category.name}</p>
            <h1>{product.name}</h1>
            <div class="divider"></div>

            {product.price && (
              <div class="product-price-block">
                <span class="product-price">{product.price}</span>
                {product.priceNote && <span class="product-price-note">{product.priceNote}</span>}
              </div>
            )}

            <p class="product-desc">{product.description}</p>

            <ul class="product-highlights">
              {product.highlights.map((point: string) => <li>{point}</li>)}
            </ul>

            <div class="hero-actions">
              <a href={waLink} class="btn btn-gold" target="_blank" rel="noopener">Pesan via WhatsApp</a>
              <a href={`${base}/${category.slug}`} class="btn btn-outline-dark">Lihat {category.name} Lain</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    {relatedProducts.length > 0 && (
      <section class="related-section">
        <div class="container">
          <h2 class="related-title">Produk Lainnya di {category.name}</h2>
          <div class="related-grid">
            {relatedProducts.map((p) => (
              <a class="related-card" href={`${base}/${category.slug}/${p.slug}`}>
                <div class="related-card-img">
                  <Image src={p.image} alt={p.alt} width={400} height={300} loading="lazy" />
                </div>
                <div class="related-card-body">
                  <h3>{p.name}</h3>
                  {p.price && <p class="related-card-price">{p.price}</p>}
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>
  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />
</Layout>

<style>
  .product-price-block {
    margin: 20px 0;
    padding: 16px 20px;
    background: var(--bg-card);
    border: 1px solid var(--line-light);
  }
  .product-price {
    display: block;
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 600;
    color: var(--wine);
  }
  .product-price-note {
    display: block;
    font-size: 13px;
    color: var(--text-muted);
    margin-top: 4px;
  }
  .related-section {
    padding: 80px 0 120px;
    background: var(--bg-light);
  }
  .related-title {
    font-family: var(--font-display);
    font-size: clamp(24px, 2.5vw, 32px);
    font-weight: 500;
    margin-bottom: 32px;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .related-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--line-light);
    overflow: hidden;
    transition: transform .35s ease, box-shadow .35s ease;
  }
  .related-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.08);
  }
  .related-card-img {
    aspect-ratio: 4/3;
    overflow: hidden;
  }
  .related-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .6s ease;
  }
  .related-card:hover .related-card-img img {
    transform: scale(1.06);
  }
  .related-card-body {
    padding: 16px 20px;
  }
  .related-card-body h3 {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 500;
    color: var(--text-dark);
    margin-bottom: 6px;
  }
  .related-card-price {
    font-size: 14px;
    font-weight: 700;
    color: var(--wine);
  }
  @media (max-width: 700px) {
    .related-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 480px) {
    .related-grid { grid-template-columns: 1fr; }
  }
</style>
